# Copy to .env for local runs only. In Azure, every one of these is set as a
# Container Apps secret/env var (see docs/secrets.md) -- never committed,
# never put in Bicep parameter files.

# The single fixed relay account. Also the real UOL mailbox credentials,
# reused to authenticate the outbound leg to smtps.uol.com.br.
RELAY_USER=cliente@uol.com.br
RELAY_PASSWORD=changeme

# Public hostname clients point their mail app at.
RELAY_DOMAIN=smtps.bratech.me

# TLS certificate the relay presents to clients (STARTTLS on 587 and
# implicit TLS on 465). See docs/security.md for how this is obtained.
TLS_CERT_FILE=/etc/smtprelay/tls/tls.crt
TLS_KEY_FILE=/etc/smtprelay/tls/tls.key

# UOL upstream. Confirmed via real connection test (docs/dns.md) --
# smtps.uol.com.br:587 with STARTTLS is correct; kept as config, not
# hardcoded, in case that ever needs to change to smtp.uol.com.br.
SMTP_UPSTREAM_HOST=smtps.uol.com.br
SMTP_UPSTREAM_PORT=587

# Listener addresses.
LISTEN_ADDR_STARTTLS=:587
LISTEN_ADDR_IMPLICIT_TLS=:465
HEALTH_ADDR=:8080

# Limits (see docs/security.md for the reasoning behind these defaults).
MAX_MESSAGE_SIZE_BYTES=15728640
MAX_RECIPIENTS=20
READ_TIMEOUT=30s
WRITE_TIMEOUT=60s
UPSTREAM_TIMEOUT=30s
RATE_LIMIT_CONN_PER_MINUTE=30
RATE_LIMIT_MSGS_PER_HOUR=200
